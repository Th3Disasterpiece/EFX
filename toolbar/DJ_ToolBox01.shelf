  <tool name="setShotRange0" label="Set Shot Range" icon="PLASMA_App">
    <toolMenuContext name="network">
      <contextNetType>OBJ</contextNetType>
      <contextNetType>SOP</contextNetType>
      <contextNetType>CHOP</contextNetType>
      <contextNetType>ROP</contextNetType>
      <contextNetType>SHOP</contextNetType>
      <contextNetType>COP2</contextNetType>
      <contextNetType>VOP</contextNetType>
      <contextNetType>VOPNET</contextNetType>
      <contextNetType>DOP</contextNetType>
      <contextNetType>TOP</contextNetType>
      <contextNetType>LOP</contextNetType>
    </toolMenuContext>
    <script scriptType="python"><![CDATA["""Shot Range UI.

A small dialog for setting Houdini's frame range, with an optional custom
range. Updated for Houdini 22 (PySide6 / Qt6).
"""

from PySide6 import QtWidgets, QtCore
import hou

DEFAULT_START = 1001
DEFAULT_END = 1200


class ShotRangeUI(QtWidgets.QDialog):
    def __init__(self, parent=None):
        super(ShotRangeUI, self).__init__(parent)
        self.setWindowTitle("Shot Range")

        # Create the UI elements (pre-filled so the fields are never blank)
        self.start_frame = QtWidgets.QLineEdit(str(DEFAULT_START))
        self.end_frame = QtWidgets.QLineEdit(str(DEFAULT_END))
        self.ok_button = QtWidgets.QPushButton("OK")
        self.check_box = QtWidgets.QCheckBox("Use Custom Range")

        # Create the layout
        layout = QtWidgets.QVBoxLayout()
        layout.addWidget(self.check_box)
        layout.addWidget(QtWidgets.QLabel("Start Frame:"))
        layout.addWidget(self.start_frame)
        layout.addWidget(QtWidgets.QLabel("End Frame:"))
        layout.addWidget(self.end_frame)
        layout.addWidget(self.ok_button)
        self.setLayout(layout)

        # Connect signals
        self.ok_button.clicked.connect(self.setTimelineRange)
        self.check_box.stateChanged.connect(self.toggleCustomRange)

        # Disable the start and end frame inputs by default
        self.start_frame.setEnabled(False)
        self.end_frame.setEnabled(False)

    def toggleCustomRange(self, state):
        # Qt6 note: stateChanged emits an int that does NOT compare equal to
        # QtCore.Qt.Checked (which is now a CheckState enum), so querying the
        # checkbox directly is the reliable, version-proof approach.
        use_custom = self.check_box.isChecked()
        self.start_frame.setEnabled(use_custom)
        self.end_frame.setEnabled(use_custom)
        if not use_custom:
            # Restore the default range on the disabled fields
            self.start_frame.setText(str(DEFAULT_START))
            self.end_frame.setText(str(DEFAULT_END))

    def setTimelineRange(self):
        if self.check_box.isChecked():
            # Get the values entered by the user, guarding against bad input
            try:
                start = int(self.start_frame.text())
                end = int(self.end_frame.text())
            except ValueError:
                hou.ui.displayMessage(
                    "Start and End frame must be whole numbers.",
                    severity=hou.severityType.Error
                )
                return
        else:
            # Use the default range
            start = DEFAULT_START
            end = DEFAULT_END

        # Set both the global frame range and the playback (scrub) range, so the
        # timeline visibly updates rather than only the underlying scene range.
        hou.playbar.setFrameRange(start, end)
        hou.playbar.setPlaybackRange(start, end)

        # Close the UI
        self.close()


def show_shot_range_ui():
    # Parent the dialog to Houdini's main window and keep a reference on
    # hou.session so Python doesn't garbage-collect it the instant this script
    # finishes - the usual reason a PySide window "flashes and disappears".
    hou.session.shot_range_ui = ShotRangeUI(hou.ui.mainQtWindow())
    hou.session.shot_range_ui.show()


show_shot_range_ui()]]></script>
  </tool>

